---
import LayoutV2 from '../layouts/LayoutV2.astro';
import { notFoundDefaults as copy } from '../content/defaults.js';
---

<LayoutV2 title="Page not found | DemandGenix" description="This page doesn’t exist. Here is where to go next." noindex>
  <div class="dg-wrap">
    <section class="dg-notfound">
      <span class="dg-kicker">Error 404</span>
      <h1>{copy.headline}</h1>
      <p class="dg-hero__sub">{copy.text}</p>
      <div class="dg-hero__actions">
        <a class="dg-btn" href={copy.primaryHref}>{copy.primaryLabel} <span class="dg-btn__arr" aria-hidden="true">&rarr;</span></a>
        <a class="dg-btn dg-btn--ghost" href={copy.secondaryHref}>{copy.secondaryLabel}</a>
      </div>
    </section>
  </div>
</LayoutV2>
