---
import LayoutV2 from '../../layouts/LayoutV2.astro';
import RichText from '../../components/v2/RichText.astro';
import { getAllBlogPosts, getBlogPostBySlug, getBlogPage, getSiteSettings, getRecentBlogPosts } from '../../lib/sanity.js';
import { formatDate, getCategoryLabel } from '../../lib/blogHelpers.js';
import { renderBlocks } from '../../lib/blogContent.js';
import { optimizeSanityImage } from '../../lib/imageHelpers.js';
import { SITE_URL } from '../../lib/seo.js';

export async function getStaticPaths() {
  const posts = await getAllBlogPosts();
  return posts.map((post: any) => ({ params: { slug: post.slug.current } }));
}

const { slug } = Astro.params;
const [post, page, settings, recent] = await Promise.all([
  getBlogPostBySlug(slug).catch((error: unknown) => {
    console.error('Error fetching blog post:', error);
    return null;
  }),
  getBlogPage(),
  getSiteSettings(),
  getRecentBlogPosts(4).catch(() => [])
]);

if (!post) return Astro.redirect('/404');

// One post has speakable (voice assistant) markup that points at its callouts and FAQ heading.
const AEO_SLUG = 'demand-gen-vs-lead-gen-which-should-your-lean-team-prioritise-right-now';
const isAeoPost = slug === AEO_SLUG;

const contentHtml = renderBlocks(post.content, { faqHeadingId: isAeoPost ? 'faq-section' : undefined });
const wordCount = (post.content || [])
  .filter((b: any) => b._type === 'block')
  .map((b: any) => (b.children || []).map((c: any) => c.text || '').join(' '))
  .join(' ')
  .split(/\s+/)
  .filter(Boolean).length;

const url = `${SITE_URL}/blog/${post.slug.current}/`;
const toIsoDateTime = (date: string) => (date?.includes('T') ? date : `${date}T00:00:00+00:00`);
const heroUrl = post.heroImage?.url;
const isFounder = !post.author || post.author === settings.founderName;
const related = (recent || []).filter((p: any) => p.slug.current !== post.slug.current).slice(0, 3);

const howTo = {
  '@type': 'HowTo',
  '@id': `${url}#howto`,
  name: 'How to transition from a lead-gen-only model to a demand-gen model on a budget',
  description:
    'A three-phase approach for lean B2B teams to introduce demand generation alongside existing lead gen activity, without pausing current pipeline activity.',
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'Review your existing content',
      text: "Identify gated content that proves your value proposition or speaks to your audience's pain points and ungate it. Make it accessible to your ICP, promote it on your website, allow search engines and LLMs to crawl it, and create long-form social posts to distribute it. This should take approximately one week, with early engagement signals visible within the first few weeks."
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'Create co-partnered content',
      text: 'Identify a partner whose audience overlaps with your ICP. Find a shared pain point and create a how-to webinar you can both promote. This broadens your engaged audience and deepens the partner relationship. Allow approximately four weeks to plan and host, and ask your partner to lead on infrastructure if they have an established audience.'
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'Take dark social seriously',
      text: 'Find the Slack groups, closed forums and Reddit communities where your ICP discusses their problems. Engage authentically and add value without being overly promotional. Start with one channel and build consistent engagement over time. Pipeline quality improvements should become visible within the same quarter.'
    }
  ]
};

const schema = {
  type: 'BlogPosting',
  dateModified: post._updatedAt,
  breadcrumbs: [
    { name: 'Home', url: '/' },
    { name: 'Blog', url: '/blog/' },
    { name: post.title, url: `/blog/${post.slug.current}/` }
  ],
  faqs: post.faqs?.length ? post.faqs : undefined,
  extra: {
    headline: post.title,
    ...(heroUrl ? { image: heroUrl } : {}),
    author: isFounder ? { '@id': `${SITE_URL}/#founder` } : { '@type': 'Person', name: post.author },
    publisher: { '@id': `${SITE_URL}/#organization` },
    datePublished: toIsoDateTime(post.publishDate),
    articleSection: getCategoryLabel(post.category),
    keywords: post.tags || [],
    wordCount,
    ...(isAeoPost ? { speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.callout-box', '#faq-section'] } } : {})
  },
  extraNodes: isAeoPost ? [howTo] : []
};
---

<LayoutV2
  title={post.metaTitle || `${post.title} | DemandGenix Blog`}
  description={post.metaDescription || post.excerpt}
  ogImage={heroUrl ? optimizeSanityImage(heroUrl, { width: 1200, height: 630, fit: 'crop', format: 'jpg' }) : undefined}
  schema={schema}
>
  <article class="dg-article">
    <div class="dg-wrap dg-wrap--read">
      <nav class="dg-crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li aria-current="page">{post.title}</li>
        </ol>
      </nav>

      <header class="dg-article__head">
        <p class="dg-postrow__meta">
          <span>{getCategoryLabel(post.category)}</span>
          <time datetime={post.publishDate}>{formatDate(post.publishDate)}</time>
          {post.readingTime && <span>{post.readingTime} min read</span>}
        </p>
        <h1>{post.title}</h1>
        {post.excerpt && <p class="dg-article__excerpt">{post.excerpt}</p>}
        <p class="dg-byline">
          By
          {settings.founderLinkedIn && isFounder
            ? <a href={settings.founderLinkedIn} target="_blank" rel="noopener">{post.author || settings.founderName}</a>
            : <strong>{post.author}</strong>}
          {isFounder && settings.founderJobTitle && <>, {settings.founderJobTitle}, {settings.tradingName}</>}
        </p>
      </header>

      {post.heroImage && (
        <figure class="dg-article__hero">
          <img
            src={optimizeSanityImage(heroUrl, { width: 1200, height: 675, fit: 'max' })}
            alt={post.heroImage.alt || ''}
            width="1200"
            height="675"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      )}

      <div class="dg-prose" set:html={contentHtml} />

      {post.faqs?.length > 0 && (
        <section class="dg-faq dg-faq--post" id="post-faqs" aria-labelledby="post-faqs-heading">
          <h2 id="post-faqs-heading">Frequently asked questions</h2>
          {post.faqs.map((faq: { question: string; answer: string }) => (
            <details>
              <summary>{faq.question}</summary>
              <div class="dg-faq__answer"><p>{faq.answer}</p></div>
            </details>
          ))}
        </section>
      )}

      {post.tags?.length > 0 && <p class="dg-tags"><strong>Topics:</strong> {post.tags.join(', ')}</p>}

      {isFounder && settings.founderBio && (
        <aside class="dg-author" aria-label="About the author">
          <h2>About the author</h2>
          <p>{settings.founderBio}</p>
          {settings.founderLinkedIn && <p><a href={settings.founderLinkedIn} target="_blank" rel="noopener">Lee on LinkedIn</a></p>}
        </aside>
      )}
    </div>
  </article>

  {related.length > 0 && (
    <section class="dg-block dg-band dg-related">
      <div class="dg-wrap dg-wrap--read">
        <h2>More from the blog</h2>
        <ul>
          {related.map((p: any) => (
            <li class="dg-post">
              <time datetime={p.publishDate}>{formatDate(p.publishDate)}</time>
              <div>
                <a class="dg-post__title" href={`/blog/${p.slug.current}/`}>{p.title}</a>
                {p.excerpt && <p>{p.excerpt}</p>}
              </div>
            </li>
          ))}
        </ul>
        <a class="dg-posts__all" href="/blog/">All articles</a>
      </div>
    </section>
  )}

  <section class="dg-block dg-close" id="book">
    <div class="dg-wrap">
      <h2>{page.postCtaHeading}</h2>
      <div>
        <a class="dg-btn" href={settings.ctaHref || '/contact/'}>{settings.ctaLabel} <span class="dg-btn__arr" aria-hidden="true">&rarr;</span></a>
        {page.postCtaNote && <p class="dg-close__note">{page.postCtaNote}</p>}
      </div>
    </div>
  </section>
</LayoutV2>
