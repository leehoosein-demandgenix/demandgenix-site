---
import LayoutV2 from '../../layouts/LayoutV2.astro';
import { getAllBlogPosts, getFeaturedBlogPosts, getBlogPage } from '../../lib/sanity.js';
import { formatDate, getCategoryLabel } from '../../lib/blogHelpers.js';
import { SITE_URL } from '../../lib/seo.js';

const [page, allPosts, featuredPosts] = await Promise.all([
  getBlogPage(),
  getAllBlogPosts().catch(() => []),
  getFeaturedBlogPosts(2).catch(() => [])
]);
const seo = page.seo;

const schema = {
  type: 'CollectionPage',
  dateModified: page._updatedAt,
  abstract: seo.summary,
  breadcrumbs: [
    { name: 'Home', url: '/' },
    { name: 'Blog', url: '/blog/' }
  ],
  extra: {
    '@type': ['CollectionPage', 'Blog'],
    blogPost: (allPosts || []).slice(0, 10).map((post: any) => ({
      '@type': 'BlogPosting',
      headline: post.title,
      description: post.excerpt,
      url: `${SITE_URL}/blog/${post.slug.current}/`,
      datePublished: post.publishDate,
      author: { '@id': `${SITE_URL}/#founder` }
    }))
  }
};
---

<LayoutV2
  title={seo.metaTitle}
  description={seo.metaDescription}
  ogImage={seo.ogImage?.url}
  canonicalUrl={seo.canonicalUrl}
  noindex={seo.noIndex}
  schema={schema}
>
  <div class="dg-wrap">
    <header class="dg-hero dg-hero--solo">
      {page.heroKicker && <span class="dg-kicker">{page.heroKicker}</span>}
      <h1>{page.heroHeadline}</h1>
      {page.heroSub && <p class="dg-hero__sub">{page.heroSub}</p>}
    </header>
  </div>

  {featuredPosts?.length > 0 && (
    <section class="dg-block dg-band dg-postlist dg-postlist--featured" id="featured" style="padding-block:3.5rem">
      <div class="dg-wrap">
        <h2>{page.featuredHeading}</h2>
        <div class="dg-postlist__items">
          {featuredPosts.map((post: any) => (
            <article class="dg-postrow dg-postrow--lead" data-blog-post>
              <p class="dg-postrow__meta">
                <span data-category>{getCategoryLabel(post.category)}</span>
                <time datetime={post.publishDate}>{formatDate(post.publishDate)}</time>
                {post.readingTime && <span>{post.readingTime} min read</span>}
              </p>
              <h3><a href={`/blog/${post.slug.current}/`}>{post.title}</a></h3>
              <p class="dg-postrow__excerpt" data-excerpt>{post.excerpt}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="dg-block dg-postlist" id="all">
    <div class="dg-wrap">
      <h2>{page.allHeading}</h2>
      {allPosts?.length > 0 ? (
        <div class="dg-postlist__items">
          {allPosts.map((post: any) => (
            <article class="dg-postrow" data-blog-post>
              <p class="dg-postrow__meta">
                <span data-category>{getCategoryLabel(post.category)}</span>
                <time datetime={post.publishDate}>{formatDate(post.publishDate)}</time>
                {post.readingTime && <span>{post.readingTime} min read</span>}
              </p>
              <h3><a href={`/blog/${post.slug.current}/`}>{post.title}</a></h3>
              <p class="dg-postrow__excerpt" data-excerpt>{post.excerpt}</p>
            </article>
          ))}
        </div>
      ) : (
        <p>No articles yet. Check back soon.</p>
      )}
    </div>
  </section>
</LayoutV2>
