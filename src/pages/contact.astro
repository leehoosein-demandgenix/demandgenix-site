---
import LayoutV2 from '../layouts/LayoutV2.astro';
import RichText from '../components/v2/RichText.astro';
import Feedback from '../components/v2/Feedback.astro';
import { getContactPage, getSiteSettings, getTestimonials } from '../lib/sanity.js';

const [page, settings, allTestimonials] = await Promise.all([getContactPage(), getSiteSettings(), getTestimonials()]);
const seo = page.seo;
const email: string = settings.email || 'hello@demandgenix.uk';
const testimonials = (allTestimonials || []).filter((t: any) => t.recommendation && t.isPublic !== false).slice(0, 3);

// "{email}" in a CMS message becomes a mailto link.
const withEmail = (text: string) => String(text || '').split('{email}');
const noConsent = withEmail(page.noConsentMessage);
const failed = withEmail(page.errorMessage);

const schema = {
  type: 'ContactPage',
  dateModified: page._updatedAt,
  abstract: seo.summary,
  breadcrumbs: [
    { name: 'Home', url: '/' },
    { name: 'Contact', url: '/contact/' }
  ]
};
---

<LayoutV2
  title={seo.metaTitle}
  description={seo.metaDescription}
  ogImage={seo.ogImage?.url}
  canonicalUrl={seo.canonicalUrl}
  noindex={seo.noIndex}
  schema={schema}
>
  <div class="dg-wrap">
    <header class="dg-hero dg-hero--solo">
      {page.heroKicker && <span class="dg-kicker">{page.heroKicker}</span>}
      <h1>{page.heroHeadline}</h1>
      <p class="dg-hero__sub">{page.heroSub}</p>
    </header>

    <div class="dg-contact">
      <section class="dg-formcard" aria-labelledby="form-heading">
        <h2 id="form-heading">{page.formHeading}</h2>
        {page.formIntro && <p class="dg-formcard__intro">{page.formIntro}</p>}

        <div id="contact-success" class="dg-alert dg-alert--ok" role="status" tabindex="-1" hidden>{page.successMessage}</div>
        <div id="contact-noconsent" class="dg-alert dg-alert--warn" role="alert" hidden>
          {noConsent[0]}<a href={`mailto:${email}`}>{email}</a>{noConsent[1]}
        </div>
        <div id="contact-error" class="dg-alert dg-alert--error" role="alert" hidden>
          {failed[0]}<a href={`mailto:${email}`}>{email}</a>{failed[1]}
        </div>

        <form
          id="contact-form"
          action="/api/contact"
          method="POST"
          novalidate
          toolname="submitContactForm"
          tooldescription="Submit a contact inquiry to DemandGenix to book a free 30-minute intro call"
        >
          <div class="dg-fields">
            <div class="dg-field">
              <label for="firstname">First name <span aria-hidden="true">*</span></label>
              <input type="text" id="firstname" name="firstname" autocomplete="given-name" required aria-required="true" aria-describedby="firstname-error" />
              <p class="dg-field__error" id="firstname-error" hidden>Please enter your first name</p>
            </div>
            <div class="dg-field">
              <label for="lastname">Last name <span aria-hidden="true">*</span></label>
              <input type="text" id="lastname" name="lastname" autocomplete="family-name" required aria-required="true" aria-describedby="lastname-error" />
              <p class="dg-field__error" id="lastname-error" hidden>Please enter your last name</p>
            </div>
          </div>
          <div class="dg-field">
            <label for="email">Email <span aria-hidden="true">*</span></label>
            <input type="email" id="email" name="email" autocomplete="email" placeholder="you@company.com" required aria-required="true" aria-describedby="email-error" />
            <p class="dg-field__error" id="email-error" hidden>Please enter a valid email address</p>
          </div>
          <div class="dg-field">
            <label for="company">Company <span aria-hidden="true">*</span></label>
            <input type="text" id="company" name="company" autocomplete="organization" required aria-required="true" aria-describedby="company-error" />
            <p class="dg-field__error" id="company-error" hidden>Please enter your company name</p>
          </div>

          <input type="hidden" name="lead_source" value="Website Contact Form" />

          <button type="submit" class="dg-btn dg-btn--block" id="submit-btn" data-label={settings.ctaLabel}>{settings.ctaLabel}</button>
          <RichText class="dg-privacy" blocks={page.privacyNote} />
        </form>
      </section>

      <aside class="dg-contact__side">
        <section class="dg-expect" aria-labelledby="expect-heading">
          <h2 id="expect-heading">{page.expectHeading}</h2>
          <ol class="dg-steps dg-steps--compact">
            {page.expectSteps.map((step: any, i: number) => (
              <li class="dg-step">
                <span class="dg-step__n" aria-hidden="true">{i + 1}</span>
                <div>
                  <h3>{step.title}</h3>
                  <RichText class="dg-step__body" blocks={step.body} />
                </div>
              </li>
            ))}
          </ol>
        </section>

        <section class="dg-details" aria-labelledby="details-heading">
          <h2 id="details-heading">{page.detailsHeading}</h2>
          <dl>
            <div><dt>Email</dt><dd><a href={`mailto:${email}`}>{email}</a></dd></div>
            {page.locationNote && <div><dt>Where</dt><dd>{page.locationNote}</dd></div>}
            {page.responseTime && <div><dt>Reply time</dt><dd>{page.responseTime}</dd></div>}
          </dl>
        </section>
      </aside>
    </div>
  </div>

  {testimonials.length > 0 && (
    <section class="dg-block dg-band dg-contact__proof">
      <div class="dg-wrap">
        <Feedback heading="Feedback from people I’ve worked with" items={testimonials} headingLevel="h2" />
      </div>
    </section>
  )}
</LayoutV2>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const successBox = document.getElementById('contact-success');
  const noConsentBox = document.getElementById('contact-noconsent');
  const errorBox = document.getElementById('contact-error');

  const getCookie = (name: string) => document.cookie.split('; ').find((r) => r.startsWith(name + '='))?.split('=')[1];
  const hasMarketingConsent = () => getCookie('marketing-consent') === 'true';
  const hasAnalyticsConsent = () => getCookie('analytics-consent') === 'true';

  const FIELDS = ['firstname', 'lastname', 'email', 'company'] as const;
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  function setInvalid(id: string, invalid: boolean) {
    const input = document.getElementById(id) as HTMLInputElement | null;
    const msg = document.getElementById(id + '-error');
    if (!input || !msg) return;
    msg.hidden = !invalid;
    if (invalid) input.setAttribute('aria-invalid', 'true');
    else input.removeAttribute('aria-invalid');
  }

  form?.addEventListener('input', (e) => {
    const id = (e.target as HTMLElement).id;
    if (FIELDS.includes(id as any)) setInvalid(id, false);
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !submitBtn) return;
    [noConsentBox, errorBox].forEach((box) => box && (box.hidden = true));

    // Existing behaviour: the form only sends once marketing cookies are accepted, otherwise the
    // visitor is asked to email instead.
    if (!hasMarketingConsent()) {
      if (noConsentBox) {
        noConsentBox.hidden = false;
        noConsentBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
      return;
    }

    let firstInvalid: HTMLElement | null = null;
    for (const id of FIELDS) {
      const input = document.getElementById(id) as HTMLInputElement;
      const value = input.value.trim();
      const bad = !value || (id === 'email' && !EMAIL_RE.test(value));
      setInvalid(id, bad);
      if (bad && !firstInvalid) firstInvalid = input;
    }
    if (firstInvalid) {
      firstInvalid.focus();
      return;
    }

    const label = submitBtn.dataset.label || submitBtn.textContent || '';
    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending...';

    const fd = new FormData(form);
    const hutk = getCookie('hubspotutk');
    const payload = {
      fields: [
        { name: 'firstname', value: fd.get('firstname') || '' },
        { name: 'lastname', value: fd.get('lastname') || '' },
        { name: 'email', value: fd.get('email') || '' },
        { name: 'company', value: fd.get('company') || '' },
        { name: 'lead_source', value: fd.get('lead_source') || 'Website Contact Form' }
      ],
      context: { hutk, pageUri: window.location.href, pageName: document.title }
    };

    try {
      // EU data centre endpoint
      const res = await fetch('https://api-eu1.hsforms.com/submissions/v3/integration/submit/146805802/2e5d9771-a003-488e-a7d3-87aeb942301c', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      if (!res.ok) {
        console.error('HubSpot submit failed', await res.text());
        throw new Error('HubSpot submit failed');
      }

      const w = window as any;
      if (typeof w.gtag !== 'undefined') {
        w.gtag('event', 'generate_lead', { event_category: 'Contact Form', event_label: 'Contact Form Submission', value: 1 });
      }
      if (hasAnalyticsConsent() && w.zaraz) {
        w.zaraz.track('form_submit', {
          form_name: 'contact_form',
          form_location: 'contact_page',
          lead_source: fd.get('lead_source') || 'Website Contact Form'
        });
      }

      form.reset();
      form.hidden = true;
      if (successBox) {
        successBox.hidden = false;
        successBox.focus();
      }
    } catch (err) {
      console.error(err);
      submitBtn.disabled = false;
      submitBtn.textContent = label;
      if (errorBox) errorBox.hidden = false;
    }
  });
</script>
