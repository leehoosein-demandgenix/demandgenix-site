---
// "Where the money goes": one column per area, printed in full into the page. No JavaScript.
export interface Props {
  widget: {
    title?: string;
    areas?: { _key?: string; name: string; fixable: string; untraceable: string }[];
  };
}
const { widget } = Astro.props;
const areas = widget?.areas ?? [];
---
{areas.length > 0 && (
  <div class="dg-spend">
    {widget.title && <h3 class="dg-spend__title">{widget.title}</h3>}
    <div class="dg-spend__cols">
      {areas.map((a) => (
        <div class="dg-spend__col">
          <h4 class="dg-spend__name">{a.name}</h4>
          <h5 class="dg-spend__label">Usually fixable</h5>
          <p>{a.fixable}</p>
          <h5 class="dg-spend__label">Often can’t be tracked</h5>
          <p>{a.untraceable}</p>
        </div>
      ))}
    </div>
  </div>
)}
