---
// A CMS photo, served at several sizes from Sanity's image CDN and cropped around its hotspot.
// Renders nothing when there is no photo, so callers can fall back gracefully.
export interface Props {
  photo?: { url?: string; alt?: string; width?: number; height?: number; hotspot?: { x: number; y: number } };
  sizes?: string;
  priority?: boolean;
  class?: string;
}
const { photo, sizes = '(max-width: 900px) 100vw, 520px', priority = false, class: className } = Astro.props;
const widths = [400, 640, 900, 1200];
const src = (w: number) => `${photo?.url}?w=${w}&auto=format&q=80&fit=max`;
const pos = photo?.hotspot ? `${Math.round(photo.hotspot.x * 100)}% ${Math.round(photo.hotspot.y * 100)}%` : '50% 25%';
---
{photo?.url && (
  <img
    class={className}
    src={src(900)}
    srcset={widths.map((w) => `${src(w)} ${w}w`).join(', ')}
    sizes={sizes}
    width={photo.width || 900}
    height={photo.height || 1125}
    alt={photo.alt || ''}
    style={`object-position:${pos}`}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    decoding="async"
  />
)}
