---
import SiteHead from '../components/SiteHead.astro';
import SiteEnd from '../components/SiteEnd.astro';

export interface Props {
  title: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  canonicalUrl?: string;
  noindex?: boolean;
  schema?: {
    type?: string;
    dateModified?: string;
    abstract?: string;
    breadcrumbs?: { name: string; url: string }[];
    faqs?: { question: string; answer: any }[];
    services?: { name: string; description?: string }[];
  };
}
---

<!DOCTYPE html>
<html lang="en-GB">
  <SiteHead {...Astro.props}>
    <slot name="head" slot="head" />
  </SiteHead>
  <body class="font-sans">
    <slot />
    <SiteEnd />
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
